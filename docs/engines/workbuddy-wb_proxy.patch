+def note_stream_limit(account, model, detail, error_finish=False):
+    """流内/流尾的限额失败也要记账，否则下一次选号还会撞同一个 (账号, 模型)。
+
+    open_upstream 的 HTTP 429 分支会给账号记 (账号, 模型) 冷却，但流式响应
+    一旦开了头（HTTP 200 已发），失败走的是流收尾/中断路径，那里此前只记
+    用量行、不给账号记任何冷却——「对话进行到一半被限额」之后紧接着的下一次
+    请求会再次选中同一个账号，直到某次上游在开流前用 HTTP 429 拒绝为止。
+
+    这里复用同一套分类器：6004（带重置墙钟的额度用满）→ note_model_cap 落盘
+    并挂冷却；软限流形状（频率限制文本 / 14003）→ unscoped 阶梯；其余带重置
+    时刻的 → 按墙钟冷却。上游以 finish_reason="error" 收尾但正文不可识别时，
+    给一次 60s 的单模型短窗口（保守但远好于立刻再撞一次）。返回 True 表示
+    记了账，调用方可以据此换号重试。
+    """
+    detail = str(detail or "")[:600]
+    reset_at = parse_rate_limit_reset(detail) if detail else None
+    soft = bool(detail) and rate_limit_is_soft_shape(detail)
+    cap = bool(detail) and rate_limit_is_cap(detail)
+    if not (reset_at or soft or cap):
+        if not error_finish:
+            return False
+        account.note_error("upstream stream finished with error", model=model,
+                           cooldown=60.0)
+        log("account %s: stream finished with error, parking '%s' for 60s"
+            % (account.uid[:8], model))
+        return True
+    if cap:
+        # 与 429 分支同一落盘口径：6004 的重置时刻是上游给的事实，跨重启成立。
+        account.note_model_cap(model, reset_at)
+    wait = (max(1.0, reset_at - time.time()) if reset_at
+            else account.note_unscoped_rate(model) if soft else 60.0)
+    account.note_error("stream limit (model throttled)", model=model,
+                       until=reset_at, cooldown=wait, detail=detail)
+    log("account %s: mid-stream limit, parking '%s' for %.0fs"
+        % (account.uid[:8], model, wait))
+    return True
 
 
