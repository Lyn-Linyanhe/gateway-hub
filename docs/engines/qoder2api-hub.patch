     def _checkin_stamped_today(self):
-        """#25-e：本地今天是否已盖章（防重复写盘的短路判据）。"""
-        return str(self.last_checkin or "").startswith(time.strftime("%Y-%m-%d"))
+        """#25-e：本地是否已在**当前签到窗口**盖章（防重复写盘的短路判据）。
+
+        官方每日奖励按 10:00（UTC+8）刷新，不是自然日 00:00。旧实现比
+        "%Y-%m-%d" 日期：任何 10:00 之前的尝试（调度器 09:00 档，或用户在
+        09:xx 手点一次）碰到的是**上一个窗口**的 CLAIMED 活动，却把今天
+        盖了章 —— 10:00 之后 can_checkin() 恒 False（启动补签也被挡），
+        看板显示「今日已签」而当天 100 Credits 还没到账。
+        窗口起点与 next_checkin_window() 同源：下一个 10:00 边界 - 24h。
+        """
+        raw = str(self.last_checkin or "")
+        if not raw:
+            return False
+        try:
+            ts = time.mktime(time.strptime(raw[:19], "%Y-%m-%d %H:%M:%S"))
+        except (ValueError, OverflowError):
+            # 兼容非标准时间串：退回自然日判断，至少不会误判成"未签"
+            return raw.startswith(time.strftime("%Y-%m-%d"))
+        return ts >= next_checkin_window()[0] - 86400
 
