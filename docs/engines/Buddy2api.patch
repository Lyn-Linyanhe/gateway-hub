+def envelope_error(raw: str) -> str | None:
+    text = (raw or "").strip()
+    if not text:
+        return None
+    try:
+        outer = json.loads(text)
+    except json.JSONDecodeError:
+        return None
+    return _envelope_error_obj(outer)
