+class _ToolCallAssembler:
+    """Keep parallel tool calls separate across malformed upstream indexes."""
+
+    def __init__(self):
+        self.slots = {}
+        self.by_id = {}
+        self.by_raw = {}
+        self.next_index = {}
+
+    def _new(self, choice_index):
+        index = self.next_index.get(choice_index, 0)
+        self.next_index[choice_index] = index + 1
+        slot = {"id": "", "index": index, "type": "function",
+                "function": {"name": "", "arguments": ""}}
+        self.slots[(choice_index, index)] = slot
+        return slot
+
+    def add(self, choice_index, call):
+        try:
+            raw_index = int(call.get("index") or 0)
+        except (TypeError, ValueError):
+            raw_index = 0
+        raw_key = (choice_index, raw_index)
+        cid = str(call.get("id") or "")
+        slot = self.by_id.get((choice_index, cid)) if cid else None
+        if slot is None:
+            slot = self.by_raw.get(raw_key)
+        if slot is None or (cid and slot.get("id") and slot["id"] != cid):
+            slot = self._new(choice_index)
+        if cid:
+            slot["id"] = cid
+            self.by_id[(choice_index, cid)] = slot
+        self.by_raw[raw_key] = slot
+        if call.get("type"):
+            slot["type"] = call["type"]
+        fn = call.get("function") or {}
+        if fn.get("name"):
+            slot["function"]["name"] = str(fn["name"])
+        if "arguments" in fn and fn.get("arguments") not in (None, ""):
+            slot["function"]["arguments"] += _argument_text(fn["arguments"])
+        return slot
+
+    def for_choice(self, choice_index):
+        return [slot for (choice, _), slot in sorted(self.slots.items())
+                if choice == choice_index]
+
