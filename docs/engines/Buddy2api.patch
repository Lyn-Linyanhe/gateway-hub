+class _CompletionState:
+    """One event contract for buffered and streaming consumers."""
+
+    def __init__(self):
+        self.usage = {}
+        self.finish = ""
+        self.done = False
+        self.choices = set()
+        self.finished = set()
+        self.tools = _ToolCallAssembler()
+
+    def feed(self, raw):
+        if raw.strip() == "[DONE]":
+            self.done = True
+            return []
+        try:
+            outer = json.loads(raw)
+        except json.JSONDecodeError:
+            return []
+        if not isinstance(outer, dict):
+            return []
+        error = _envelope_error_obj(outer)
+        if error:
+            raise _StreamError(error)
+        if outer.get("error"):
+            raise _StreamError(str(outer["error"]))
+        if str(outer.get("body") or "").strip() == "[DONE]":
+            self.done = True
+        usage, finish = _usage_from_obj(outer)
+        self.usage.update(usage)
+        events = []
+        for inner in _unwrap_parsed(outer):
+            try:
+                item = inner if isinstance(inner, (dict, list)) else json.loads(inner)
+            except (json.JSONDecodeError, TypeError):
+                continue
+            if not isinstance(item, dict):
+                continue
+            if item.get("error"):
+                raise _StreamError(str(item["error"]))
+            choices = item.get("choices")
+            if not isinstance(choices, list):
+                continue
+            if isinstance(item.get("usage"), dict):
+                self.usage.update(item["usage"])
+            for choice in choices:
+                if not isinstance(choice, dict):
+                    raise _StreamError("Invalid upstream choice")
+                try:
+                    index = int(choice.get("index") or 0)
+                except (TypeError, ValueError):
+                    raise _StreamError("Invalid upstream choice index") from None
+                delta = choice.get("delta", choice.get("message", {}))
+                if not isinstance(delta, dict):
+                    raise _StreamError("Invalid upstream delta")
+                choice["delta"] = delta
+                self.choices.add(index)
+                if choice.get("finish_reason"):
+                    self.finished.add(index)
+                    self.finish = str(choice["finish_reason"])
+                for call in delta.get("tool_calls") or []:
+                    if not isinstance(call, dict) or not isinstance(call.get("function", {}), dict):
+                        raise _StreamError("Invalid upstream tool call")
+                    slot = self.tools.add(index, call)
+                    call["index"] = slot["index"]
+                    fn = call.get("function") or {}
+                    if fn.get("arguments") is not None:
+                        fn["arguments"] = _argument_text(fn["arguments"])
+            events.append(item)
+        return events
+
+    def require_complete(self):
+        if not self.choices:
+            raise _StreamError("Upstream returned no chat choices")
+        if not self.done and not self.choices.issubset(self.finished):
+            raise _StreamError("Upstream stream ended before completion")
