+    cols = {r["name"] for r in conn.execute("PRAGMA table_info(logs)").fetchall()}
+    if "cached_tokens" not in cols:
+        conn.execute("ALTER TABLE logs ADD COLUMN cached_tokens INTEGER")
+    if "cacheable_tokens" not in cols:
+        conn.execute("ALTER TABLE logs ADD COLUMN cacheable_tokens INTEGER")
+    conn.commit()
